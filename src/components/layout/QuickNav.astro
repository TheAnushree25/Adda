---
import { site } from '@data/site';
import Icon from '@components/ui/Icon.astro';
import Button from '@components/ui/Button.astro';
import { url } from '@lib/paths';
---

<nav class="quick-nav" aria-label="Quick actions" data-module="quick-nav">
  <div class="quick-nav__bar" data-intro-nav>
    <button
      class="quick-nav__link"
      type="button"
      data-sheet-open="sheet-visit"
      aria-expanded="false"
      aria-controls="sheet-visit"
    >
      Find us
    </button>
    <button
      class="quick-nav__link"
      type="button"
      data-sheet-open="sheet-book"
      aria-expanded="false"
      aria-controls="sheet-book"
    >
      Book a table
    </button>
    <a class="quick-nav__link quick-nav__link--wide" href={site.orderUrl}>
      Order online
    </a>
    <a class="quick-nav__link quick-nav__link--wide" href={site.giftUrl}>
      Gift cards
    </a>
  </div>
</nav>

<!-- Find us sheet -->
<div
  id="sheet-visit"
  class="sheet"
  role="dialog"
  aria-modal="true"
  aria-labelledby="sheet-visit-title"
  hidden
  data-module="sheet"
>
  <div class="sheet__backdrop" data-sheet-backdrop></div>
  <div class="sheet__panel theme-plum" data-sheet-panel tabindex="-1">
    <div class="sheet__head" data-sheet-item>
      <h2 id="sheet-visit-title" class="t-headline-s">
        Find us
      </h2>
      <button class="sheet__close" type="button" data-sheet-close aria-label="Close">
        <Icon name="close" size={22} />
      </button>
    </div>
    <p class="t-body-s" data-sheet-item>
      On the corner of {site.address.street} — two minutes from the old market square, with bike racks out
      front and street parking after 6 pm.
    </p>
    <div class="sheet__grid" data-sheet-item>
      <div>
        <p class="t-label-s sheet__label">Address</p>
        <a class="t-label-m" href={site.mapsUrl} target="_blank" rel="noopener noreferrer">
          {site.address.street}
          <br />
          {site.address.city}, {site.address.region}
          {site.address.postalCode}
        </a>
      </div>
      <div>
        <p class="t-label-s sheet__label">Phone</p>
        <a class="t-label-m" href={site.phone.href}>
          {site.phone.display}
        </a>
      </div>
    </div>
    <div class="sheet__row" data-sheet-item>
      <p class="t-label-s sheet__label">Hours</p>
      <p class="t-label-m sheet__status" data-module="open-status">
        &nbsp;
      </p>
      <p class="t-body-s">Hours can change on holidays — check before a special trip.</p>
    </div>
    <div data-sheet-item>
      <Button href={site.mapsUrl} tone="light" external>
        Get directions
      </Button>
    </div>
  </div>
</div>

<!-- Book a table sheet -->
<div
  id="sheet-book"
  class="sheet"
  role="dialog"
  aria-modal="true"
  aria-labelledby="sheet-book-title"
  hidden
  data-module="sheet"
>
  <div class="sheet__backdrop" data-sheet-backdrop></div>
  <div class="sheet__panel theme-plum" data-sheet-panel tabindex="-1">
    <div class="sheet__head" data-sheet-item>
      <h2 id="sheet-book-title" class="t-headline-s">
        Book a table
      </h2>
      <button class="sheet__close" type="button" data-sheet-close aria-label="Close">
        <Icon name="close" size={22} />
      </button>
    </div>
    <p class="t-body-s" data-sheet-item>
      Tables of one to eight can book by phone or email. Walk-ins are always welcome at the bar and on the
      terrace. For nine or more, see{' '}
      <a href={url('/private-dining/')} class="sheet__inline-link">
        private dining
      </a>
      .
    </p>
    <div class="sheet__grid" data-sheet-item>
      <div>
        <p class="t-label-s sheet__label">Call</p>
        <a class="t-label-m" href={site.phone.href}>
          {site.phone.display}
        </a>
      </div>
      <div>
        <p class="t-label-s sheet__label">Email</p>
        <a class="t-label-m" href={`mailto:${site.email}?subject=Table%20booking`}>
          {site.email}
        </a>
      </div>
    </div>
    <div data-sheet-item>
      <Button href={site.phone.href} tone="light">
        Call to book
      </Button>
    </div>
  </div>
</div>

<style>
  .quick-nav {
    position: fixed;
    left: 50%;
    bottom: 2rem;
    z-index: var(--z-nav);
    transform: translateX(-50%);
    transition: transform 0.6s var(--ease-out);
  }

  .quick-nav.is-hidden {
    transform: translate(-50%, calc(100% + 3rem));
  }

  .quick-nav__bar {
    display: flex;
    box-shadow: 0 18px 50px -20px rgb(29 20 19 / 0.45);
  }

  .quick-nav__link {
    position: relative;
    z-index: 0;
    display: inline-flex;
    align-items: center;
    height: var(--btn-h);
    padding: 0 2rem;
    background: var(--c-paper);
    color: var(--c-plum);
    border: 1px solid var(--c-plum);
    font-size: var(--fs-label-m);
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    white-space: nowrap;
    isolation: isolate;
    transition: color var(--dur-m) var(--ease-out);
  }

  .quick-nav__link + .quick-nav__link {
    margin-left: -1px;
  }

  .quick-nav__link::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--c-plum);
    clip-path: inset(100% 0 0 0);
    transition: clip-path var(--dur-m) var(--ease-out);
  }

  @media (hover: hover) {
    .quick-nav__link:hover {
      color: var(--c-paper);
    }
    .quick-nav__link:hover::before {
      clip-path: inset(0);
    }
  }

  .quick-nav__link[aria-expanded='true'] {
    color: var(--c-paper);
  }
  .quick-nav__link[aria-expanded='true']::before {
    clip-path: inset(0);
  }

  @media (max-width: 700px) {
    .quick-nav {
      left: 0;
      right: 0;
      bottom: 0;
      transform: none;
    }
    .quick-nav.is-hidden {
      transform: translateY(110%);
    }
    .quick-nav__bar {
      width: 100%;
    }
    .quick-nav__link {
      flex: 1;
      justify-content: center;
      padding: 0 0.5rem;
      height: 3.25rem;
      font-size: 0.72rem;
      text-align: center;
      white-space: normal;
      line-height: 1.1;
    }
    .quick-nav__link--wide {
      flex: 1.15;
    }
  }

  /* Sheets ---------------------------------------------------------------- */
  .sheet {
    position: fixed;
    inset: 0;
    z-index: var(--z-sheet);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding: 1rem 1rem 6.5rem;
  }

  .sheet__backdrop {
    position: absolute;
    inset: 0;
    background: rgb(29 20 19 / 0.55);
    backdrop-filter: blur(3px);
  }

  .sheet__panel {
    position: relative;
    width: min(36rem, 100%);
    max-height: calc(100svh - 8rem);
    overflow-y: auto;
    display: grid;
    gap: 1.5rem;
    padding: 2rem;
    box-shadow: 0 30px 80px -30px rgb(29 20 19 / 0.6);
  }

  .sheet__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .sheet__close {
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-items: center;
    border: 1px solid currentColor;
    border-radius: 50%;
    transition: transform var(--dur-m) var(--ease-out);
  }
  @media (hover: hover) {
    .sheet__close:hover {
      transform: rotate(90deg);
    }
  }

  .sheet__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    padding-block: 1.25rem;
    border-block: 1px solid rgb(var(--c-paper-rgb) / 0.35);
  }

  .sheet__label {
    opacity: 0.8;
    margin-bottom: 0.35rem;
  }

  .sheet__row {
    display: grid;
    gap: 0.35rem;
  }

  .sheet__status::before {
    content: '';
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.5rem;
    border-radius: 50%;
    background: currentColor;
    vertical-align: 0.1em;
  }

  .sheet__inline-link {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  @media (max-width: 700px) {
    .sheet {
      padding: 0 0 3.25rem;
    }
    .sheet__panel {
      width: 100%;
      padding: 1.5rem var(--container-pad) 2rem;
    }
    .sheet__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
