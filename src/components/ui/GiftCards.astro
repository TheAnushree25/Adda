---
/** Illustrated stack of gift cards (pure SVG, brand colours). */
import { site } from '@data/site';
import { ribbon } from '@lib/shapes';

const marble = [ribbon(71, 300, 190, 4, 0.35), ribbon(72, 300, 190, 5, 0.4), ribbon(73, 300, 190, 3, 0.3)];
---

<svg class="gift-cards" viewBox="0 0 420 300" role="img" aria-label="Illustration of Mirabelle gift cards">
  <defs>
    <clipPath id="card-clip">
      <rect x="0" y="0" width="300" height="190" rx="14"></rect>
    </clipPath>
  </defs>

  <!-- Back card (mauve marble) -->
  <g transform="translate(40 52) rotate(-16 150 95)">
    <g clip-path="url(#card-clip)">
      <rect width="300" height="190" fill="#7a4a54"></rect>
      {marble.map((d, i) => (
        <path
          d={d}
          fill="none"
          stroke={['#321c22', '#d9c4c8', '#f7f6f4'][i]}
          stroke-width={[26, 10, 3][i]}
          stroke-linecap="round"
          opacity="0.8"
        />
      ))}
    </g>
  </g>

  <!-- Middle card (paper, receipt-like back) -->
  <g transform="translate(118 92) rotate(9 150 95)">
    <rect width="300" height="190" rx="14" fill="#f7f6f4"></rect>
    <rect x="0" y="26" width="300" height="28" fill="#46181a" opacity="0.85"></rect>
    {[78, 94, 110, 126].map((y, i) => (
      <rect x="24" y={y} width={[170, 140, 160, 110][i]} height="5" rx="2.5" fill="#46181a" opacity="0.25" />
    ))}
    <text
      x="276"
      y="172"
      text-anchor="end"
      font-family="var(--f-display)"
      font-style="italic"
      font-weight="700"
      font-size="22"
      fill="#4b2b32"
    >
      {site.name}
    </text>
  </g>

  <!-- Front card (plum) -->
  <g transform="translate(58 96) rotate(-4 150 95)">
    <g clip-path="url(#card-clip)">
      <rect width="300" height="190" fill="#4b2b32"></rect>
      {marble.map((d, i) => (
        <path
          d={d}
          transform="translate(0 30) scale(1 0.8)"
          fill="none"
          stroke={['#321c22', '#d9c4c8', '#7a4a54'][i]}
          stroke-width={[30, 8, 4][i]}
          stroke-linecap="round"
          opacity="0.75"
        />
      ))}
    </g>
    <text
      x="22"
      y="58"
      font-family="var(--f-display)"
      font-style="italic"
      font-weight="700"
      font-size="40"
      fill="#f7f6f4"
      style="font-variation-settings:'SOFT' 100,'WONK' 1"
    >
      Gift card
    </text>
    <text
      x="22"
      y="166"
      font-family="var(--f-sans)"
      font-weight="800"
      font-size="12"
      letter-spacing="2"
      fill="#f7f6f4"
    >
      {site.name.toUpperCase()} · {site.since}
    </text>
  </g>
</svg>

<style>
  .gift-cards {
    width: 100%;
    height: auto;
    overflow: visible;
    filter: drop-shadow(0 22px 26px rgb(29 20 19 / 0.35));
  }
</style>
