---
/** Circular photo with an optional plate-like ring and parallax drift (used as floating accents). */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt?: string;
  size?: string;
  class?: string;
  parallax?: number;
  position?: string;
  /** Adds a paper-coloured rim and a soft drop shadow. */
  ring?: boolean;
}

const {
  src,
  alt = '',
  size = '14rem',
  class: className,
  parallax,
  position = '50% 50%',
  ring = false,
} = Astro.props;
---

<div
  class:list={['round-photo', ring && 'round-photo--ring', className]}
  style={`--size:${size}`}
  data-parallax={parallax}
  aria-hidden={alt ? undefined : 'true'}
>
  <Image
    src={src}
    alt={alt}
    widths={[320, 480, 720]}
    sizes={`(max-width: 700px) 50vw, ${size}`}
    class="round-photo__img"
    style={`object-position:${position}`}
    loading="lazy"
    decoding="async"
  />
</div>

<style>
  .round-photo {
    width: var(--size);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    transform: translateZ(0);
  }

  .round-photo--ring {
    --ring: clamp(5px, 0.35rem + 0.25vw, 10px);
    border: var(--ring) solid var(--c-paper);
    box-shadow:
      0 0 0 1px rgb(var(--c-paper-rgb) / 0.35),
      0 34px 60px -30px rgb(20 8 10 / 0.6);
  }

  .round-photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.4s var(--ease-out);
  }
</style>
