---
/** Wordmark: the brand name set in Fraunces with soft, wonky letterforms. */
import { site } from '@data/site';

interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<span class:list={['logo', className]} aria-hidden="true">
  <span class="logo__word">{site.name}</span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: baseline;
    font-family: var(--f-display);
    font-style: italic;
    font-weight: 700;
    font-variation-settings:
      'opsz' 144,
      'SOFT' 100,
      'WONK' 1;
    font-size: clamp(1.9rem, 1.55rem + 1.5vw, 2.9rem);
    line-height: 1;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .logo__word {
    display: block;
    padding: 0.08em 0.06em 0.12em;
  }
</style>
