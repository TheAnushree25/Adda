---
/**
 * Inline line icons (24×24, stroke = currentColor). Decorative by default;
 * pass `label` to expose the icon to assistive technology.
 */
export type IconName =
  | 'arrow-left'
  | 'arrow-right'
  | 'arrow-up-right'
  | 'chevron-down'
  | 'close'
  | 'clock'
  | 'pin'
  | 'phone'
  | 'mail'
  | 'instagram'
  | 'facebook'
  | 'plate'
  | 'croissant'
  | 'pizza'
  | 'cup'
  | 'glass'
  | 'sun'
  | 'sparkle'
  | 'leaf'
  | 'heart'
  | 'flame'
  | 'music';

interface Props {
  name: IconName;
  size?: number;
  label?: string;
  class?: string;
}

const { name, size = 20, label, class: className } = Astro.props;

const paths: Record<IconName, string> = {
  'arrow-left': '<path d="M19 12H5M11 6l-6 6 6 6"/>',
  'arrow-right': '<path d="M5 12h14M13 6l6 6-6 6"/>',
  'arrow-up-right': '<path d="M7 17 17 7M8 7h9v9"/>',
  'chevron-down': '<path d="m6 9 6 6 6-6"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  clock: '<circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/>',
  pin: '<path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z"/><circle cx="12" cy="10" r="2.4"/>',
  phone:
    '<path d="M6.6 3.8h2.6l1.5 4.2-2 1.4a11 11 0 0 0 5.9 5.9l1.4-2 4.2 1.5v2.6a2 2 0 0 1-2.2 2A16.2 16.2 0 0 1 4.6 6a2 2 0 0 1 2-2.2z"/>',
  mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="2"/><path d="m4 7 8 6 8-6"/>',
  instagram:
    '<rect x="4" y="4" width="16" height="16" rx="4.5"/><circle cx="12" cy="12" r="3.6"/><circle cx="16.8" cy="7.2" r="0.6" fill="currentColor"/>',
  facebook:
    '<path d="M14.2 20v-7h2.4l.4-2.8h-2.8V8.5c0-.8.3-1.4 1.4-1.4H17V4.6a19 19 0 0 0-2.2-.1c-2.2 0-3.6 1.3-3.6 3.7v2h-2.4V13h2.4v7"/>',
  plate:
    '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="5"/><path d="M2 4v5a2 2 0 0 0 2 2M2 4v16M22 4c-1.7 1-2.2 3-2.2 5h2.2M22 4v16"/>',
  croissant:
    '<path d="M4.5 15.5c-1.6-3.3.4-8 4.3-9.6 3.9-1.6 9 .4 10.6 4.1"/><path d="M4.5 15.5 9 13l-1.2-5.6M19.4 10 15 11.3l.6-5.6M12.2 8.2 12 12.8"/><path d="M4.5 15.5c3.3 2.4 11 2.4 14.9-5.5"/>',
  pizza:
    '<path d="M12 21 3.6 6.6a14 14 0 0 1 16.8 0z"/><path d="M5.2 9.4a11 11 0 0 1 13.6 0"/><circle cx="10" cy="12" r="1.1"/><circle cx="13.8" cy="14.6" r="1"/><circle cx="12.6" cy="10.4" r="0.9"/>',
  cup: '<path d="M4 9h12v5a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5z"/><path d="M16 10.5h1.5a2.5 2.5 0 0 1 0 5H16M8 3.5c-.6 1 .6 1.6 0 2.6M12 3.5c-.6 1 .6 1.6 0 2.6"/>',
  glass: '<path d="M7 3.5h10l-.7 6.2a4.3 4.3 0 0 1-8.6 0z"/><path d="M12 14v6.5M8.5 20.5h7M7.5 8h9"/>',
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"/>',
  sparkle:
    '<path d="M12 3c.8 4.6 3.6 7.6 8 8.5-4.4.9-7.2 3.9-8 8.5-.8-4.6-3.6-7.6-8-8.5 4.4-.9 7.2-3.9 8-8.5z"/>',
  leaf: '<path d="M5 19c0-8 5-14 15-14 0 10-6 15-14 15"/><path d="M5 19 13 11"/>',
  heart:
    '<path d="M12 20s-7.5-4.6-7.5-10.2A4.3 4.3 0 0 1 12 7.2a4.3 4.3 0 0 1 7.5 2.6C19.5 15.4 12 20 12 20z"/>',
  flame:
    '<path d="M12 21c-3.9 0-6.5-2.6-6.5-6.1 0-4.6 4.4-6.4 4.4-11 2.9 1.7 4.7 4.5 4.6 7.3 1-.6 1.7-1.6 2-2.9 1.3 1.5 2 3.4 2 5.6 0 4.2-2.7 7.1-6.5 7.1z"/>',
  music:
    '<path d="M9 18V5.5l11-2v12.4"/><circle cx="6.5" cy="18" r="2.5"/><circle cx="17.5" cy="16" r="2.5"/>',
};
---

<svg
  class:list={['icon', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
  set:html={paths[name]}
/>

<style>
  .icon {
    flex: none;
  }
</style>
