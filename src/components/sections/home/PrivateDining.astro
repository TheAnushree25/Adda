---
import { Image } from 'astro:assets';
import Eyebrow from '@components/ui/Eyebrow.astro';
import Button from '@components/ui/Button.astro';
import room from '@assets/images/room-round-table.jpg';
import { swirl, ribbon } from '@lib/shapes';
import { url } from '@lib/paths';

const swirls = [
  { d: swirl(7, 600, 600), cls: 'pd__swirl--a' },
  { d: ribbon(61, 900, 500, 4, 0.3), cls: 'pd__swirl--b' },
  { d: swirl(19, 600, 600), cls: 'pd__swirl--c' },
];
---

<section class="pd theme-plum section section--compact" aria-labelledby="pd-title">
  {swirls.map((s, i) => (
    <svg
      class:list={['pd__swirl u-decor', s.cls]}
      viewBox={i === 1 ? '0 0 900 500' : '0 0 600 600'}
      aria-hidden="true"
    >
      <path
        d={s.d}
        data-draw
        fill="none"
        stroke="var(--c-mauve)"
        stroke-width={i === 1 ? 34 : 40}
        stroke-linecap="round"
      />
    </svg>
  ))}

  <div class="pd__inner container">
    <div class="pd__copy">
      <Eyebrow>Private dining</Eyebrow>
      <h2 id="pd-title" class="t-display-s pd__title" data-reveal="lines">
        Celebrate big in our most intimate rooms
      </h2>
      <div class="pd__text">
        <p class="t-body-m" data-reveal="fade-up">
          Birthdays, rehearsal dinners, the team’s end-of-year toast — three rooms for 10 to 40 guests, menus
          shaped around you and a host who thinks of everything.
        </p>
        <div data-reveal="fade-up" data-reveal-delay="0.1">
          <Button href={url('/private-dining/')} tone="light">
            Plan your event
          </Button>
        </div>
      </div>
    </div>

    <div class="pd__media" data-reveal="image">
      <div class="arch pd__arch">
        <Image
          src={room}
          alt="A round dining table set for dinner in a warm private room"
          widths={[480, 760, 1100]}
          sizes="(max-width: 1000px) 90vw, 36vw"
          loading="lazy"
          decoding="async"
          data-parallax="6"
          data-parallax-zoom
        />
      </div>
    </div>
  </div>
</section>

<style>
  .pd {
    overflow: clip;
  }

  .pd__swirl {
    position: absolute;
    pointer-events: none;
  }
  .pd__swirl--a {
    width: 34rem;
    right: -6rem;
    top: -8rem;
  }
  .pd__swirl--b {
    width: 40rem;
    left: -14rem;
    bottom: -9rem;
    transform: rotate(-24deg);
  }
  .pd__swirl--c {
    width: 22rem;
    right: 30%;
    bottom: -12rem;
    opacity: 0.85;
  }

  .pd__inner {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 3rem;
    align-items: center;
  }

  .pd__copy {
    grid-column: 1 / 7;
    display: grid;
    gap: 1.75rem;
  }

  .pd__text {
    display: grid;
    gap: 2rem;
    justify-items: start;
    margin-left: clamp(0rem, -4rem + 12vw, 13rem);
    max-width: 26rem;
    margin-top: 1rem;
  }

  .pd__media {
    grid-column: 8 / 13;
  }

  .pd__arch {
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 1000px) {
    .pd__copy,
    .pd__media {
      grid-column: 1 / -1;
    }
    .pd__media {
      max-width: 28rem;
    }
  }
</style>
