---
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/nunito/index.css';
import '@fontsource-variable/newsreader/opsz-italic.css';
import '@styles/global.css';

import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-full-normal.woff2?url';
import nunitoLatin from '@fontsource-variable/nunito/files/nunito-latin-wght-normal.woff2?url';

import Header from '@components/layout/Header.astro';
import MobileMenu from '@components/layout/MobileMenu.astro';
import QuickNav from '@components/layout/QuickNav.astro';
import Footer from '@components/layout/Footer.astro';
import Curtain from '@components/layout/Curtain.astro';
import Intro from '@components/layout/Intro.astro';
import { site } from '@data/site';
import { services } from '@data/hours';
import ogDefault from '@assets/images/hero-table.jpg';
import { getImage } from 'astro:assets';
import { url } from '@lib/paths';

export type HeaderTheme = 'plum' | 'paper' | 'deep';

interface Props {
  title?: string;
  description?: string;
  /** Colour scheme of the header while it sits over the top of this page. */
  headerTheme?: HeaderTheme;
  /** Page identifier, used for styling hooks. */
  page?: string;
  noindex?: boolean;
}

const {
  title,
  description = site.description,
  headerTheme = 'paper',
  page = 'page',
  noindex = false,
} = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = await getImage({ src: ogDefault, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, Astro.site);

const dayCodes = ['Su', 'Mo', 'Tu', 'We', 'Th', 'Fr', 'Sa'];
const main = services[0]!;
const openingHours = Object.entries(main.days)
  .filter(([, h]) => h)
  .map(([d, h]) => `${dayCodes[Number(d)]} ${h![0]}-${h![1]}`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Restaurant',
  name: site.legalName,
  description: site.description,
  url: new URL(url('/'), Astro.site).toString(),
  telephone: site.phone.href.replace('tel:', ''),
  email: site.email,
  servesCuisine: ['Bistro', 'Café', 'Pizza'],
  priceRange: '$$',
  acceptsReservations: true,
  foundingDate: String(site.since),
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    addressLocality: site.address.city,
    addressRegion: site.address.region,
    postalCode: site.address.postalCode,
    addressCountry: site.address.country,
  },
  openingHours,
  image: ogUrl.toString(),
};
---

<!doctype html>
<html lang={site.locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta name="theme-color" content="#4b2b32" />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/site.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" href={frauncesLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={nunitoLatin} as="font" type="font/woff2" crossorigin />

    <!-- Flags JS + motion preference before first paint (external file keeps the CSP strict). -->
    <script is:inline src={url('/js/boot.js')}></script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body data-page={page}>
    <Intro />
    <a class="skip-link" href="#main">
      Skip to content
    </a>

    <Header />
    <MobileMenu />

    <main
      id="swup"
      class="site-main"
      data-header-theme={headerTheme}
      data-page={page}
      data-module="reveal parallax counter morph draw"
    >
      <span id="main" tabindex="-1"></span>
      <slot />
    </main>

    <Footer />
    <QuickNav />
    <Curtain />

    <script>
      import '@scripts/app';
    </script>
  </body>
</html>
