{
  "name": "mirabelle-cafe",
  "version": "1.0.0",
  "private": true,
  "description": "Mirabelle — café, bistro & bar. A cinematic, static marketing site built with Astro, GSAP, Lenis, Swup and OGL.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "node scripts/ensure-compiler.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/ensure-compiler.mjs",
    "build": "astro build",
    "build:pages": "node scripts/ensure-compiler.mjs && astro build --site https://theanushree25.github.io --base /Adda/",
    "preview": "astro preview",
    "serve": "node scripts/serve.mjs",
    "lettering": "node scripts/build-lettering.mjs",
    "precheck": "node scripts/ensure-compiler.mjs",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run check && npm run lint && npm run build"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@swup/body-class-plugin": "^3.3.0",
    "@swup/head-plugin": "^2.3.1",
    "@swup/js-plugin": "^3.2.0",
    "@swup/preload-plugin": "^3.2.12",
    "astro": "^7.4.11",
    "embla-carousel": "^8.6.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "ogl": "^1.0.11",
    "swup": "^4.10.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@fontsource/playfair-display": "^5.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "opentype.js": "^2.0.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  },
  "optionalDependencies": {
    "@astrojs/compiler-binding-wasm32-wasi": "^0.5.3"
  }
}
